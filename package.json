{
  "name": "save-the-world-game",
  "version": "0.6.0-beta.4",
  "description": "A compact strategy game about the AI transition",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "c8 --exclude=tests/** --exclude=eslint.config.js node --test tests/*.test.mjs",
    "test:coverage:html": "c8 --exclude=tests/** --exclude=eslint.config.js --reporter=html --reporter=text node --test tests/*.test.mjs",
    "lint": "eslint *.js",
    "test:all": "npm run lint && npm test"
  },
  "devDependencies": {
    "c8": "^8.0.1",
    "eslint": "^9.30.0"
  }
}
